# Build products. The .app bundle is assembled by install.sh from Resources/,
# so nothing under here is source and none of it should ever be committed.
.build/
*.o
*.dSYM/

# macOS clutter
.DS_Store

# Local editor state
.swiftpm/
*.xcuserstate

# Raw captures do not belong in history. Screenshots in Resources/screenshots
# are downscaled from the demo library before being committed.
Resources/screenshots/Screenshot*.png

# Release artefacts are attached to GitHub releases, not committed.
dist/
